{
  "compilerOptions": {
    "target": "ES2022",
    "useDefineForClassFields": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "forceConsistentCasingInFileNames": true,
    "paths": {
      "@/*": ["./src/*"],
      "@cayfore/engine/products": ["../../packages/engine/src/products.ts"],
      "@cayfore/engine/unit-costs": ["../../packages/engine/src/unit-costs/index.ts"],
      "@cayfore/engine/rate-confidence": ["../../packages/engine/src/catalog/sources/rate-confidence.ts"],
      "@cayfore/engine": ["../../packages/engine/src/index.ts"]
    }
  },
  "include": ["src"]
}
