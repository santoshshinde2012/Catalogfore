{
  "name": "databricks-cost-forecaster",
  "private": true,
  "version": "0.1.0",
  "description": "Open-source Databricks cost forecasting calculator",
  "license": "MIT",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*",
    "mcp"
  ],
  "scripts": {
    "dev": "npm run dev -w @dcf/web",
    "build": "npm run typecheck -w @dcf/engine && npm run build -w @dcf/web && npm run build -w @dcf/mcp",
    "test": "vitest run && node --test scripts/parse-prices.test.mjs",
    "test:e2e": "playwright test",
    "test:mcp": "node scripts/mcp-smoke.mjs",
    "lint": "eslint .",
    "typecheck": "npm run typecheck -w @dcf/engine && npm run typecheck -w @dcf/web && npm run typecheck -w @dcf/mcp",
    "preview": "npm run preview -w @dcf/web",
    "refresh-prices": "node scripts/refresh-prices.mjs"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.2",
    "@eslint/js": "^9.32.0",
    "@playwright/test": "^1.55.0",
    "@types/node": "^22.17.0",
    "eslint": "^9.32.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.39.0",
    "vitest": "^3.2.4"
  },
  "engines": {
    "node": ">=20"
  }
}
