{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/santoshshinde2012/cayfore/data/product-catalog.schema.json",
  "title": "Cayfore product catalog",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "verifiedOn", "disclaimer", "categories", "knownAzureMeters", "products"],
  "properties": {
    "version": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}\\.\\d+$" },
    "verifiedOn": { "type": "string", "format": "date" },
    "disclaimer": { "type": "string", "minLength": 1 },
    "categories": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "label"],
        "properties": {
          "id": {
            "enum": ["data_engineering", "warehousing_bi", "ai_ml", "apps_oltp", "governance_sharing"]
          },
          "label": { "type": "string" }
        }
      }
    },
    "knownAzureMeters": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "products": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/product" }
    }
  },
  "$defs": {
    "product": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "menuLabel",
        "summary",
        "category",
        "billingUnit",
        "sku",
        "listPrice",
        "published",
        "confidence",
        "confidenceScore",
        "automation",
        "template",
        "editor",
        "drivers",
        "defaults",
        "source",
        "note"
      ],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9_]+$" },
        "name": { "type": "string" },
        "menuLabel": { "type": "string", "maxLength": 80 },
        "summary": { "type": "string" },
        "category": {
          "enum": ["data_engineering", "warehousing_bi", "ai_ml", "apps_oltp", "governance_sharing"]
        },
        "billingUnit": { "type": "string" },
        "sku": { "type": ["string", "null"] },
        "listPrice": { "enum": ["distinct", "reused_sku", "unpublished"] },
        "published": { "type": "boolean" },
        "confidence": { "enum": ["measured", "cited", "secondary", "unpublished"] },
        "confidenceScore": { "type": "integer", "minimum": 0, "maximum": 100 },
        "automation": { "enum": ["azure-retail-prices", "manual"] },
        "template": {
          "enum": [
            "jobs",
            "all_purpose",
            "dlt",
            "serverless_jobs",
            "serverless_notebooks",
            "serverless_dlt",
            "sql",
            "serving",
            "foundation",
            "search",
            "app",
            "lakebase",
            "storage",
            "egress",
            "metered"
          ]
        },
        "editor": { "enum": ["builtin", "schema"] },
        "drivers": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
        "defaults": { "type": "string" },
        "source": {
          "type": "object",
          "additionalProperties": false,
          "required": ["title", "url", "fetchedOn"],
          "properties": {
            "title": { "type": "string" },
            "url": { "type": "string", "format": "uri" },
            "fetchedOn": { "type": "string", "format": "date" }
          }
        },
        "note": { "type": "string" },
        "fields": { "type": "array", "items": { "$ref": "#/$defs/field" } },
        "patch": { "type": "object" },
        "azureMeterNames": { "type": "array", "items": { "type": "string" } },
        "formula": {
          "enum": [
            "genie_code",
            "genie_llm_free",
            "genie_sql",
            "dashboard_sql",
            "ai_parse",
            "custom_fm",
            "launch",
            "azure_data_processed",
            "zerobus_gb"
          ]
        },
        "parts": { "type": "array", "items": { "$ref": "#/$defs/part" } }
      }
    },
    "part": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "template"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9_]+$" },
        "name": { "type": "string", "maxLength": 80 },
        "template": { "$ref": "#/$defs/product/properties/template" },
        "editor": { "enum": ["builtin", "schema"] },
        "formula": { "$ref": "#/$defs/product/properties/formula" },
        "fields": { "type": "array", "items": { "$ref": "#/$defs/field" } },
        "patch": { "type": "object" }
      }
    },
    "field": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "label", "type"],
      "properties": {
        "path": { "type": "string" },
        "label": { "type": "string" },
        "type": { "enum": ["number", "select", "boolean"] },
        "min": { "type": "number" },
        "max": { "type": "number" },
        "step": { "type": "number" },
        "options": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["value", "label"],
            "properties": { "value": { "type": "string" }, "label": { "type": "string" } }
          }
        }
      }
    }
  }
}
